{
    "name": "egerstudios/brreg-api",
    "description": "Laravel package for consuming the Brønnøysundregistrene open API",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "Jan Tore Eger-Schøyen",
            "email": "egerstudio.utvikling@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "YourVendor\\BrregApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourVendor\\BrregApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Egerstudios\\BrregApi\\BrregApiServiceProvider"
            ],
            "aliases": {
                "BrregApi": "Egerstudios\\BrregApi\\Facades\\BrregApi"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix",
        "check-style": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "analyse": "vendor/bin/phpstan analyse"
    }
}